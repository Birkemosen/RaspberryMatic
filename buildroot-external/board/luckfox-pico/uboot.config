# U-Boot Configuration for Luckfox Pico in RaspberryMatic
# Based on Rockchip's U-Boot with HomeMatic support

# Boot Media Support
CONFIG_ROCKCHIP_MMC=y
CONFIG_ROCKCHIP_EMMC=y
CONFIG_ROCKCHIP_SPI_NAND=y
CONFIG_ROCKCHIP_SPI_NOR=y

# eMMC Configuration
CONFIG_MMC=y
CONFIG_MMC_ROCKCHIP=y
CONFIG_MMC_ROCKCHIP_EMMC=y
CONFIG_MMC_ROCKCHIP_SDIO=y
CONFIG_MMC_BOUNCE_BUFFER=y
CONFIG_MMC_VERBOSE=y
CONFIG_MMC_TRACE=y

# SPI NAND Support
CONFIG_MTD=y
CONFIG_MTD_NAND=y
CONFIG_MTD_NAND_ROCKCHIP=y
CONFIG_MTD_SPI_NAND=y
CONFIG_MTD_SPI_NOR=y

# Boot Device Selection
CONFIG_ROCKCHIP_BOOT_MODE_REG=y
CONFIG_ROCKCHIP_BOOT_MODE_MMC=y
CONFIG_ROCKCHIP_BOOT_MODE_SPI_NAND=y
CONFIG_ROCKCHIP_BOOT_MODE_SPI_NOR=y

# Fast Boot Support
CONFIG_ROCKCHIP_FAST_BOOT=y
CONFIG_ROCKCHIP_FAST_BOOT_MMC=y
CONFIG_ROCKCHIP_FAST_BOOT_SPI_NAND=y

# Environment Storage
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_IS_IN_SPI_FLASH=y
CONFIG_ENV_IS_IN_SPI_NAND=y

# Boot Commands
CONFIG_CMD_MMC=y
CONFIG_CMD_MTD=y
CONFIG_CMD_MTDPARTS=y
CONFIG_CMD_UBI=y
CONFIG_CMD_UBIFS=y

# Device Tree Support
CONFIG_OF_CONTROL=y
CONFIG_OF_SEPARATE=y
CONFIG_OF_BOARD_SETUP=y

# Network Boot
CONFIG_CMD_NET=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_CMD_BOOTP=y
CONFIG_CMD_DHCP=y

# USB Boot
CONFIG_CMD_USB=y
CONFIG_CMD_USB_MASS_STORAGE=y
CONFIG_CMD_FAT=y
CONFIG_CMD_EXT4=y

# HomeMatic Specific
CONFIG_HOMEMATIC_BOOT=y
CONFIG_HOMEMATIC_CCU=y
CONFIG_HOMEMATIC_RF=y

# Security
CONFIG_ROCKCHIP_CRYPTO=y
CONFIG_ROCKCHIP_SECURE_BOOT=y
CONFIG_ROCKCHIP_ATF=y
