# Luckfox Pico Kernel Configuration for RaspberryMatic
# Based on Rockchip's develop-6.1 branch

# ARM Architecture
CONFIG_ARM=y
CONFIG_ARM_PATCH_PHYS_VIRT=y
CONFIG_ARM_LPAE=y
CONFIG_ARM_THUMB=y
CONFIG_ARM_THUMBEE=y
CONFIG_ARM_VIRT_EXT=y
CONFIG_ARM_CPU_SUSPEND=y

# Rockchip SoC Support
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ROCKCHIP_IOMMU=y
CONFIG_ROCKCHIP_PM_DOMAINS=y
CONFIG_ROCKCHIP_SUSPEND_MODE=y

# RV1103/RV1106 Specific
CONFIG_ARCH_RV110X=y
CONFIG_ROCKCHIP_RV1106=y

# Device Tree
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_OF_ADDRESS_PCI=y
CONFIG_OF_IRQ=y
CONFIG_OF_NET=y
CONFIG_OF_MDIO=y
CONFIG_OF_RESERVED_MEM=y

# Serial Console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_ROCKCHIP=y

# GPIO Support
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_ROCKCHIP=y
CONFIG_GPIO_ROCKCHIP_PCA953X=y

# I2C Support
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_HELPER_AUTO=y
CONFIG_I2C_ROCKCHIP=y

# SPI Support
CONFIG_SPI=y
CONFIG_SPI_ROCKCHIP=y
CONFIG_SPI_ROCKCHIP_SFC=y

# USB Support
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_ROCKCHIP=y
CONFIG_USB_STORAGE=y

# Network Support
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_ROCKCHIP_GMAC=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y

# Camera/ISP Support - Smart Home Monitoring
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_VIDEO_ROCKCHIP_ISP=y
CONFIG_VIDEO_ROCKCHIP_ISP1=y
CONFIG_VIDEO_ROCKCHIP_ISP1_DEV=y
CONFIG_VIDEO_ROCKCHIP_ISP1_V1=y
CONFIG_VIDEO_ROCKCHIP_ISP1_V2=y

# NPU Support - AI-Powered Home Automation
CONFIG_ROCKCHIP_NPU=y
CONFIG_ROCKCHIP_NPU_DRIVER=y

# Storage Support
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=8
CONFIG_MMC_ROCKCHIP=y
CONFIG_MMC_ROCKCHIP_SDIO=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_NAND=y
CONFIG_MTD_NAND_ROCKCHIP=y
CONFIG_MTD_SPI_NOR=y

# File Systems
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NTFS_FS=y
CONFIG_MSDOS_FS=y
CONFIG_FAT_FS=y
CONFIG_SQUASHFS=y

# Audio Support
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_ROCKCHIP=y
CONFIG_SND_SOC_ROCKCHIP_MAX98090=y

# HomeMatic/homematicIP Specific
CONFIG_HOMEMATIC=y
CONFIG_HOMEMATIC_CCU=y
CONFIG_HOMEMATIC_RF=y
CONFIG_HOMEMATIC_WIRED=y

# Boot Configuration
CONFIG_CMDLINE="console=ttyS2,115200 root=/dev/mmcblk0p2 rootwait rw"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
