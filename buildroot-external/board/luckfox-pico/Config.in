config BR2_TARGET_LUCKFOX_PICO
	bool "Luckfox Pico"
	select BR2_arm
	select BR2_ARM_CPU_ARMV7A
	select BR2_ARM_FPU_VFPV4
	select BR2_ARM_EABIHF
	select BR2_ARM_INSTRUCTIONS_ARM
	help
	  Luckfox Pico development board with RaspberryMatic support.
	  
	  This board provides:
	  - RV1103/RV1106 ARM Cortex-A7 SoC
	  - Camera/ISP support for smart home monitoring
	  - NPU for AI-powered home automation
	  - WiFi and Ethernet connectivity
	  - Full HomeMatic/homematicIP compatibility
	  
	  https://github.com/LuckfoxTECH/luckfox-pico
