# Luckfox Pico Ultra W Kernel Configuration Fragment
# Based on luckfox_rv1106_linux_defconfig

# RV1106 SoC support
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ROCKCHIP_RV1106=y

# ARM Cortex-A7 configuration
CONFIG_ARM=y
CONFIG_CPU_32v7=y
CONFIG_CPU_CORTEX_A7=y
CONFIG_CPU_HAS_NEON=y
CONFIG_CPU_HAS_VFPV4=y

# Memory configuration
CONFIG_VMSPLIT_3G_OPT=y
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTE=66

# Device tree support
CONFIG_OF=y
CONFIG_OF_OVERLAY=y
CONFIG_OF_DTBO=y

# Storage support
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=8
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

# EMMC support
CONFIG_MMC_BLOCK_MINORS=8
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

# USB support
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_DWC3_DUAL_ROLE=y

# WiFi and Bluetooth support
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTL8723DS=m
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCSP=y
CONFIG_BT_HCIUART_ATH3K=y
CONFIG_BT_HCIUART_LL=y
CONFIG_BT_HCIUART_3WIRE=y
CONFIG_BT_HCIUART_INTEL=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_HCIUART_AG6XX=y
CONFIG_BT_HCIUART_MRVL=y

# GPIO support
CONFIG_GPIO_SYSFS=y
CONFIG_GPIO_ROCKCHIP=y

# I2C support
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_HELPER_AUTO=y
CONFIG_I2C_ALGOBIT=y

# SPI support
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_SPI_ROCKCHIP=y

# UART support
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# Network support
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_ROCKCHIP=y
CONFIG_GMAC_ROCKCHIP=y

# Camera and ISP support
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_ROCKCHIP_ISP=y
CONFIG_VIDEO_ROCKCHIP_ISP_DPHY=y
CONFIG_VIDEO_ROCKCHIP_ISP_DPHY_RX1=y
CONFIG_VIDEO_ROCKCHIP_ISP_DPHY_TX1RX1=y
CONFIG_VIDEO_ROCKCHIP_ISP_DPHY_TX1RX1_4LANES=y

# NPU support
CONFIG_ROCKCHIP_RVNPU=y
CONFIG_ROCKCHIP_RVNPU_DRIVER=y

# Power management
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_PM_WAKELOCKS=y

# Debug support
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_GPIO=y
CONFIG_DEBUG_MMC=y
CONFIG_DEBUG_USB=y

# Security
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_DEFAULT_SECURITY_DAC=y
CONFIG_LSM="lockdown,yama,loadpin,safesetid,integrity"

# Filesystem support
CONFIG_EXT4_FS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NTFS_FS=y
CONFIG_SQUASHFS=y
CONFIG_UBIFS_FS=y

# Compression
CONFIG_LZ4_COMPRESS=y
CONFIG_LZ4_DECOMPRESS=y
CONFIG_ZSTD_COMPRESS=y
CONFIG_ZSTD_DECOMPRESS=y
