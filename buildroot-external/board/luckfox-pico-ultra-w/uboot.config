# Luckfox Pico Ultra W U-Boot configuration
CONFIG_ARM=y
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARCH_RV1106=y
CONFIG_SYS_ARCH="arm"
CONFIG_SYS_CPU="armv7"
CONFIG_SYS_SOC="rv1106"
CONFIG_SYS_VENDOR="rockchip"
CONFIG_SYS_BOARD="luckfox-pico-ultra-w"
CONFIG_SYS_CONFIG_NAME="luckfox_rv1106_uboot_defconfig"

# Boot settings
CONFIG_BOOTDELAY=3
CONFIG_BOOTCOMMAND="run distro_bootcmd"
CONFIG_BOOTARGS="console=ttyS2,115200 root=/dev/mmcblk0p2 rootwait"

# Environment
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_OFFSET=0x8000
CONFIG_ENV_SIZE=0x8000

# Device tree
CONFIG_OF_CONTROL=y
CONFIG_OF_SEPARATE=y
CONFIG_DEFAULT_DEVICE_TREE="rv1106g-luckfox-pico-ultra-w"

# Storage
CONFIG_MMC=y
CONFIG_MMC_ROCKCHIP=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_ROCKCHIP=y

# Network
CONFIG_NET=y
CONFIG_CMD_NET=y
CONFIG_CMD_PING=y
CONFIG_CMD_DHCP=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_NET_RANDOM_ETHADDR=y

# USB
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_STORAGE=y
CONFIG_CMD_USB=y

# File systems
CONFIG_FS_EXT4=y
CONFIG_FS_FAT=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FAT=y

# Commands
CONFIG_CMD_BOOTZ=y
CONFIG_CMD_BOOTM=y
CONFIG_CMD_LOADB=y
CONFIG_CMD_LOADS=y
CONFIG_CMD_FLASH=y
CONFIG_CMD_SAVEENV=y
CONFIG_CMD_SAVES=y 