# Luckfox Pico Ultra W Recovery Kernel Configuration Fragment
# This configuration is used for the recovery system

# Recovery-specific kernel options
CONFIG_RECOVERY_MODE=y
CONFIG_RECOVERY_DEBUG=n
CONFIG_RECOVERY_VERBOSE=n

# Minimal kernel configuration for recovery
CONFIG_MODULES=n
CONFIG_MODULE_UNLOAD=n
CONFIG_MODULE_FORCE_UNLOAD=n
CONFIG_MODVERSIONS=n
CONFIG_MODULE_SRCVERSION_ALL=n

# Disable unnecessary features for recovery
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_DWARF4=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_GDB_SCRIPTS=n

# Enable only essential drivers
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=8
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y

# USB support for recovery
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y

# Network support for recovery
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y

# Filesystem support
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_USE_FOR_EXT2=y

# Recovery tools
CONFIG_CRYPTO=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y

# Compression support
CONFIG_CRYPTO_DEFLATE=y
CONFIG_CRYPTO_LZO=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_ZSTD=y

# Hardware support
CONFIG_GPIO_ROCKCHIP=y
CONFIG_PINCTRL_ROCKCHIP=y
CONFIG_CLK_ROCKCHIP=y
CONFIG_RESET_CONTROLLER=y

# Serial console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# Watchdog for recovery
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_ROCKCHIP_WATCHDOG=y

# Power management
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_HIBERNATION=n

# Memory management
CONFIG_CMA=y
CONFIG_CMA_SIZE_MBYTE=32
CONFIG_CMA_ALIGNMENT=8

# Device tree support
CONFIG_OF=y
CONFIG_OF_FLATTREE=y
CONFIG_OF_EARLY_FLATTREE=y
CONFIG_OF_OVERLAY=y

# Boot configuration
CONFIG_CMDLINE="console=ttyS0,115200 root=/dev/ram0 rw recovery"
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_CMDLINE_EXTEND=y

# Recovery-specific features
CONFIG_RECOVERY_PARTITION=y
CONFIG_RECOVERY_UPDATE=y
CONFIG_RECOVERY_VERIFY=y
CONFIG_RECOVERY_BACKUP=y

# Security for recovery
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_DEFAULT_SECURITY_DAC=y

# Logging for recovery
CONFIG_PRINTK=y
CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_MESSAGE_LOGLEVEL_DEFAULT=4
CONFIG_CONSOLE_LOGLEVEL_QUIET=4
CONFIG_DEFAULT_MESSAGE_LOGLEVEL=4

# Error handling
CONFIG_PANIC_TIMEOUT=5
CONFIG_PANIC_ON_OOPS=n
CONFIG_PANIC_ON_RT_THROTTLING=n

# Recovery environment
CONFIG_RECOVERY_ENV=y
CONFIG_RECOVERY_SCRIPT=y
CONFIG_RECOVERY_CMD=y
