BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_TIME_BITS_64=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_1=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(BR2_EXTERNAL_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION)"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_EQ3_PATH)/board/luckfox-pico-ultra/kernel-patches"
BR2_LINUX_KERNEL_DEFCONFIG="pico-ultra-w"
#BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_EQ3_PATH)/kernel/6.1/global.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.1/device-support.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.1/security-arm32.config $(BR2_EXTERNAL_EQ3_PATH)/kernel/6.12/security.config $(BR2_EXTERNAL_EQ3_PATH)/board/luckfox-pico-ultra/kernel.config"
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_RPI_USERLAND=y
BR2_TARGET_ROOTFS_CPIO_UIMAGE=y
BR2_PACKAGE_WIRINGPI_RPI=y
